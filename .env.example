PORT=3000
REDIS_URL=redis://localhost:6379

# Admin panel protection token
ADMIN_TOKEN=change_me_strong_token

# API Keys (optional - omit for dev without auth)
# PUBLIC_API_KEY=your_public_key_for_pwa
# API_KEYS=key1,key2
API_KEYS_STORE=./data/api-keys.json

# First-party frontend origins that can call API without x-api-key (comma-separated full URLs)
INTERNAL_APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: your live site (merged with INTERNAL_APP_ORIGINS). Example:
# FRONTEND_PUBLIC_ORIGIN=https://www.onepanchang.com,https://onepanchang.com
